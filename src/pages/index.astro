---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Event from "@components/Event";
import ProjectCard from "@components/ProjectCard.astro";
import BuyMeACoffee from "@components/BuyMeACoffee";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import getSortedEvents from "@utils/getSortedEvents";
import getPostSlug from "@utils/getPostSlug";
import { projects } from "../data/projects";
import { SOCIALS } from "@config";

const posts = getSortedPosts(await getCollection("blog"));
const featuredPosts = posts.filter(({ data }) => data.featured);
const recentPosts = posts.filter(({ data }) => !data.featured).slice(0, 3);

const events = getSortedEvents(await getCollection("speaking"));
const recentTalks = events
  .filter(
    ({ data }) => data.completed && data.link && /\btalk\b/i.test(data.name)
  )
  .slice(0, 3);

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout
  description="Aurora Scharff is a software engineer on the Next.js team at Vercel. Demo apps, practical guides, and talks on React and Next.js."
>
  <Header />
  <main id="main-content">
    <section id="hero" class="flow-root">
      <img
        src="/assets/main.JPG"
        alt="Aurora Scharff"
        width="3200"
        height="3200"
        fetchpriority="high"
        class="mb-4 mt-4 w-40 rounded-lg sm:float-right sm:ml-6 sm:mt-8 sm:w-1/3"
      />
      <h1>Hey, I'm Aurora ♡</h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="rss-link"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
          ><path
            d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
          ></path><path
            d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
          ></path><circle cx="6" cy="18" r="2"></circle>
        </svg>
        <span class="sr-only">RSS Feed</span>
      </a>
      <p>
        I'm a software engineer from Norway. I work on developer experience,
        docs, and education on the Next.js team at <a
          href="https://vercel.com"
          target="_blank"
          class="text-link">Vercel</a
        >, and I'm the React Certification Lead at <a
          href="https://certificates.dev"
          target="_blank"
          class="text-link">certificates.dev</a
        >.
      </p>
      <p>
        Here you'll find the demo apps I build to work through React and Next.js
        patterns, the guides I write about what I learn from them, and
        recordings of my talks. There's more on the <a
          href="/about"
          class="text-link">about page</a
        >.
      </p>
      {
        socialCount > 0 && (
          <div class="social-wrapper">
            <div class="social-links">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr />

    <section id="projects">
      <h2>Projects</h2>
      <p class="section-desc">
        Demo apps for trying out new Next.js features in something closer to a
        real app. Each one has a live demo and its source on GitHub.
      </p>
      <ul>
        {projects.map(project => <ProjectCard project={project} />)}
      </ul>
      <LinkButton href="/projects/" className="more-link">
        All projects
        <svg xmlns="http://www.w3.org/2000/svg"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured">
            <h2>Featured Posts</h2>
            <ul>
              {featuredPosts.map(post => (
                <Card
                  href={`/posts/${getPostSlug(post)}/`}
                  frontmatter={post.data}
                  secHeading={false}
                />
              ))}
            </ul>
          </section>
          <Hr />
        </>
      )
    }

    <section id="recent-posts">
      <h2>Recent Posts</h2>
      <ul>
        {
          recentPosts.map(post => (
            <Card
              href={`/posts/${getPostSlug(post)}/`}
              frontmatter={post.data}
              secHeading={false}
            />
          ))
        }
      </ul>
      <LinkButton href="/posts/" className="more-link">
        All posts
        <svg xmlns="http://www.w3.org/2000/svg"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </section>

    <Hr />

    <section id="talks">
      <h2>Recent Talks</h2>
      <ul>
        {recentTalks.map(({ data }) => <Event frontmatter={data} />)}
      </ul>
      <LinkButton href="/speaking/" className="more-link">
        All talks and workshops
        <svg xmlns="http://www.w3.org/2000/svg"
          ><path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </section>
  </main>

  <div
    class="mb-8 mt-4 flex flex-col items-center justify-center gap-4 text-center sm:flex-row sm:text-start"
  >
    If you would like to support my work, you can
    <BuyMeACoffee client:load />
  </div>

  <Footer />
</Layout>

<style>
  /* ===== Hero Section ===== */
  #hero {
    @apply pb-6 pt-8;
  }
  #hero h1 {
    @apply my-4 mr-2 inline-block text-3xl font-bold sm:my-8 sm:text-4xl;
  }
  #hero .rss-link {
    @apply mb-6;
  }
  #hero .rss-icon {
    @apply mb-2 h-6 w-6 scale-110 fill-skin-accent sm:mb-3 sm:scale-125;
  }
  #hero p {
    @apply my-2;
  }
  .text-link {
    @apply underline decoration-dashed underline-offset-4 hover:text-skin-accent;
  }
  .social-wrapper {
    @apply mt-4 flex flex-col sm:flex-row sm:items-center;
  }
  .social-links {
    @apply mb-1 mr-2 whitespace-nowrap sm:mb-0;
  }

  /* ===== Content Sections ===== */
  #projects,
  #featured,
  #recent-posts,
  #talks {
    @apply pb-6 pt-12;
  }
  #projects h2,
  #featured h2,
  #recent-posts h2,
  #talks h2 {
    @apply text-2xl font-semibold tracking-wide;
  }
  .section-desc {
    @apply mt-2;
  }
  .more-link {
    @apply mt-2 underline decoration-dashed underline-offset-8;
  }
</style>
